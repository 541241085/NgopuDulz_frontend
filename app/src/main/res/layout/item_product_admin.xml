<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Gambar Produk -->
        <ImageView
            android:id="@+id/iv_admin_product_img"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_americano" />

        <!-- Info Detail Produk -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_admin_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Kopi..."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_admin_product_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kategori"
                android:textColor="#8E8E8E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_admin_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rp 0"
                android:textColor="#E5A93C"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Aksi Edit & Delete -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Tombol Edit -->
            <ImageView
                android:id="@+id/btn_admin_edit_product"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#162335"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#42A5F5"
                android:layout_marginEnd="8dp"/>

            <!-- Tombol Delete -->
            <ImageView
                android:id="@+id/btn_admin_delete_product"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#2D1919"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#EF5350" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>