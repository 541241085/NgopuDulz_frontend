<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- HEADER TITLE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar_admin_users"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1A1A1A"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manajemen Akun Pengguna"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2 KATEGORI FILTER (CUSTOMER & KASIR) -->
    <RadioGroup
        android:id="@+id/rg_kategori_user"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/top_bar_admin_users">

        <RadioButton
            android:id="@+id/rb_cat_customer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@android:color/transparent"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="👥 Pelanggan"
            android:textColor="#E5A93C"
            android:textStyle="bold"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rb_cat_kasir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@android:color/transparent"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="💼 Kasir/Pegawai"
            android:textColor="#8E8E8E"
            android:textStyle="bold"/>
    </RadioGroup>

    <View
        android:id="@+id/divider_user"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E2E"
        app:layout_constraintTop_toBottomOf="@id/rg_kategori_user"/>

    <!-- RECYCLERVIEW LIST ACCOUNTS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_admin_users"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_user"
        tools:listitem="@layout/item_users_admin" />

</androidx.constraintlayout.widget.ConstraintLayout>