<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <ImageButton
            android:id="@+id/ic_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Pesanan Sedang Dibuat"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imgMenu"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/img_macchiato" />

            <TextView android:id="@+id/tvNamaUser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nama: Hana" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/tvMenu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Menu: Ice Caramel Macchiato" android:textSize="16sp"/>
            <TextView android:id="@+id/tvAddOns" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add-ons: Caramel Sauce" android:textSize="14sp" android:textColor="#555555"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="12dp"/>

            <TextView android:id="@+id/tvNote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Note: -" android:textStyle="italic"/>

            <TextView android:id="@+id/tvTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total: Rp 35.000" android:textSize="20sp" android:textStyle="bold" android:gravity="end" android:layout_marginTop="16dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <Button
        android:id="@+id/btnSelesai"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SELESAI"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@android:color/black"
        android:textColor="@android:color/white"/>

</LinearLayout>