<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Halo, Kasir!" android:textColor="#FFFFFF" android:textSize="14sp"/>

            <TextView android:id="@+id/tv_pendapatan_hari_ini" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Pendapatan Hari Ini: Rp 0" android:textColor="#FF9800"
                android:textSize="18sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- 👇 INI DIA TOMBOL LOGOUT-NYA 👇 -->
        <ImageView
            android:id="@+id/btn_logout_kasir"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="#FF5252" />
    </RelativeLayout>

    <RadioGroup
        android:id="@+id/rg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <RadioButton
            android:id="@+id/rb_antrian"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Antrian (0)"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rb_proses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proses (0)"/>

        <RadioButton
            android:id="@+id/rb_selesai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Selesai (0)"/>
    </RadioGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_kasir_antrian"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/rg_status"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_layout"/>

    <LinearLayout
        android:id="@+id/bottom_action_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>